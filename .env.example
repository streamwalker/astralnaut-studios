# =============================================================================
# Astralnaut Studios — environment reference
# =============================================================================
#
# Two classes of variable live here, and the distinction matters:
#
#   PUBLIC  — inlined into the client bundle at build time. Not secret. These
#             are already committed in .env / .env.development / .env.production
#             because the build needs them and they ship to every browser anyway.
#
#   SECRET  — server-only. NEVER commit these. In production they are Cloudflare
#             Worker secrets; locally they go in .dev.vars (already gitignored).
#
# Set a production secret with:
#   npx wrangler secret put NAME --config .output/server/wrangler.json
#
# =============================================================================
# PUBLIC — build-time, safe to commit (already in .env*)
# =============================================================================

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<supabase anon/publishable key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Stripe publishable key. pk_test_... in .env.development, pk_live_... in
# .env.production. The build mode selects which file is loaded.
VITE_PAYMENTS_CLIENT_TOKEN="pk_live_..."

# Meta Pixel ID. Publishable — it appears in the page source of every site
# running a pixel. Set ONLY in .env.production: src/lib/meta-pixel.ts no-ops
# entirely when it resolves to "", which keeps dev and preview traffic out of
# the ad account. The pixel still only fires after marketing consent.
VITE_META_PIXEL_ID=

# SSR mirrors of the Supabase public values (server reads process.env when
# import.meta.env is unavailable).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<supabase anon/publishable key>"
SUPABASE_PROJECT_ID="<project-ref>"

# =============================================================================
# SECRET — Cloudflare Worker secrets. Required in production.
# =============================================================================

# --- Database -----------------------------------------------------------
# Bypasses RLS. Server-only, used by src/integrations/supabase/client.server.ts.
# Rotate this in the Supabase dashboard as part of the Lovable offboarding —
# Lovable's platform held a copy.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments -----------------------------------------------------------
# Previously proxied through connector-gateway.lovable.dev; now called
# directly by src/lib/stripe.server.ts. Generate in the Stripe dashboard.
STRIPE_LIVE_API_KEY=            # sk_live_...
STRIPE_SANDBOX_API_KEY=         # sk_test_...

# Signing secrets for the /api/public/payments/webhook endpoint. Shown once
# when you create the webhook endpoint in Stripe.
PAYMENTS_LIVE_WEBHOOK_SECRET=       # whsec_...
PAYMENTS_SANDBOX_WEBHOOK_SECRET=    # whsec_...

# --- Email --------------------------------------------------------------
# Direct Resend API key. Used by src/lib/emails.server.ts (noreply@) and
# src/lib/leads.server.ts (hello@). Both From addresses require
# astralnautstudios.com to be a verified sending domain in Resend, which
# means adding Resend's SPF and DKIM records at the IONOS DNS panel.
RESEND_API_KEY=                 # re_...

# --- Cron / game-event authentication -----------------------------------
# Shared HMAC secret guarding /api/public/game-events and the cron endpoints
# /api/public/cron/renewal-reminders and /api/public/cron/retention.
# Any high-entropy random string: openssl rand -hex 32
ARCHIVE_GAME_EVENTS_HMAC_SECRET=

# =============================================================================
# CONFIG — non-secret server values
# =============================================================================

# Absolute origin used to build links in outbound email (double opt-in
# confirmation, subscription management). No trailing slash.
# Falls back to https://astralnautstudios.com when unset.
SITE_URL="https://astralnautstudios.com"
PUBLIC_SITE_URL="https://astralnautstudios.com"

# Returned to users who complete a community attestation. Optional — the
# feature degrades to null when unset.
DISCORD_INVITE_URL=
